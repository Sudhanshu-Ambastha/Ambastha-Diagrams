{
  "name": "ambastha-diagrams",
  "displayName": "Ambastha Diagrams",
  "publisher": "SudhanshuAmbastha",
  "version": "1.1.0",
  "description": "Diagram previewer for .abd files.",
  "keywords": [
    "diagram",
    "diagram-as-code",
    "flowchart",
    "architecture",
    "abd",
    "previewer",
    "visualization"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams"
  },
  "homepage": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams#readme",
  "bugs": {
    "url": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams/issues"
  },
  "main": "./dist/desktop/extension.js",
  "browser": "./dist/web/extension.js",
  "categories": [
    "Visualization",
    "Programming Languages",
    "Education",
    "Snippets",
    "Linters",
    "Other"
  ],
  "icon": "icons/logo.png",
  "activationEvents": [
    "onLanguage:abd"
  ],
  "scripts": {
    "sync-changelog": "copyfiles -f ../CHANGELOG.md .",
    "prebuild": "npm run sync-changelog",
    "prepublishOnly": "npm run sync-changelog",
    "build": "webpack --mode production",
    "clean": "rimraf dist",
    "test-web": "npm run clean && npm run build && npx @vscode/test-web --extensionDevelopmentPath=.",
    "test-desktop": "npm run clean && npm run build"
  },
  "contributes": {
    "languages": [
      {
        "id": "abd",
        "aliases": [
          "Ambastha Diagram",
          "abd"
        ],
        "extensions": [
          ".abd"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/logo.svg",
          "dark": "./icons/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "abd",
        "scopeName": "source.abd",
        "path": "./dist/web/syntax/abd.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "copy-webpack-plugin": "^14.0.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^6.1.3",
    "webpack": "^5.108.1",
    "webpack-cli": "^7.0.3"
  },
  "dependencies": {
    "ambastha-engine": "^1.1.0"
  }
}
