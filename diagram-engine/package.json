{
  "name": "diagram-engine",
  "version": "1.0.0",
  "description": "Zero-dependency SVG diagram renderer. Lightweight Mermaid alternative — 40x smaller, works in browsers, VS Code Web, and Node.js.",
  "keywords": [
    "diagram",
    "svg",
    "flowchart",
    "sequence",
    "gantt",
    "mermaid-alternative",
    "zero-dependency",
    "headless",
    "vscode-web"
  ],
  "author": "Ambastha",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./core/index.js"
    },
    "./registry": {
      "import": "./registry/register.js"
    },
    "./examples": {
      "import": "./registry/examples.json",
      "default": "./registry/examples.json"
    }
  },
  "main": "./core/index.js",
  "module": "./core/index.js",
  "files": [
    "core/",
    "registry/",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/diagram-engine"
  },
  "bugs": {
    "url": "https://github.com/yourusername/diagram-engine/issues"
  },
  "homepage": "https://github.com/yourusername/diagram-engine#readme"
}
