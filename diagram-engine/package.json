{
  "name": "ambastha-engine",
  "version": "1.1.0",
  "description": "Core parsing, layout, and visualization engine for Ambastha Diagrams",
  "keywords": [
    "diagram",
    "svg",
    "flowchart",
    "sequence",
    "gantt",
    "mermaid-alternative",
    "zero-dependency",
    "headless",
    "vscode-web",
    "documentation",
    "dsl"
  ],
  "author": "Sudhanshu Ambastha",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./core/index.js",
      "default": "./core/index.js"
    },
    "./examples": {
      "import": "./registry/examples.json",
      "default": "./registry/examples.json"
    },
    "./syntax": {
      "default": "./syntax/abd.tmLanguage.json"
    },
    "./theme": {
      "import": "./core/theme/colors.js",
      "default": "./core/theme/colors.js"
    }
  },
  "main": "./core/index.js",
  "module": "./core/index.js",
  "scripts": {
    "build": "echo 'No build required' || true",
    "sync-changelog": "copyfiles -f ../CHANGELOG.md .",
    "prepublishOnly": "npm run sync-changelog"
  },
  "files": [
    "core/",
    "registry/",
    "syntax/",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams"
  },
  "bugs": {
    "url": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams/issues"
  },
  "homepage": "https://github.com/Sudhanshu-Ambastha/Ambastha-Diagrams#readme",
  "devDependencies": {
    "copyfiles": "^2.4.1"
  }
}
