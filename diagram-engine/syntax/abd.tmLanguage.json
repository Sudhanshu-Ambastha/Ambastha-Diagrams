{
  "diagram-type-line": {
    "patterns": [
      {
        "name": "keyword.control.abd",
        "match": "^\\s*(flowchart|sequence|class|cpm|pert|gantt|kanban|usecase|stateMachine|ERDiagram)\\s*$"
      }
    ]
  },
  "property-lines": {
    "patterns": [
      {
        "match": "\\b(theme|fontTheme|ss|shape|fill|stroke|textColor|fontSize|fontWeight|type|activity|duration|predecessor|optimistic|likely|pessimistic|title|dateformat|view|startdate|firstdayofweek|progress|color|customstart|milestonedate|milestonedeps|milestonecolor|section|status|dateFormat|startDate|firstDayOfWeek|milestoneDate|milestoneDeps|milestoneColor)\\s*(:)",
        "captures": {
          "1": { "name": "entity.name.tag.abd" },
          "2": { "name": "punctuation.separator.key-value.abd" }
        }
      }
    ]
  },
  "structure-keywords": {
    "patterns": [
      {
        "name": "keyword.control.flow.abd",
        "match": "(?i)\\b(struct|group|loop|alt|else|opt|note|left of|right of|actor|participant|startstop|io|decision|process|external|system|milestone|in|as|over|service|choice|final|fork|join|shallowHistory|entity|state)\\b"
      }
    ]
  },
  "separators": {
    "patterns": [
      { "name": "punctuation.separator.comma.abd", "match": "," },
      {
        "name": "constant.language.abd",
        "match": "(?<=:\\s*)_(?=\\s*[,;]|\\s*$)"
      },
      {
        "comment": "Access specifiers, PK/FK/visibility markers, and ERD cardinality brackets",
        "name": "keyword.operator.access.abd",
        "match": "(?<=^\\s{0,5})[+\\-*#~](?=[a-zA-Z])|\\{[0-9\\.\\s,n]+\\}"
      }
    ]
  }
}
